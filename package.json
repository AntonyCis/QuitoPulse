{
  "name": "radar-quito",
  "private": true,
  "version": "0.1.0",
  "description": "Radar Quito - Plataforma de reportes ciudadanos geolocalizados",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @radar-quito/api db:generate",
    "db:migrate": "pnpm --filter @radar-quito/api db:migrate",
    "db:push": "pnpm --filter @radar-quito/api db:push",
    "db:studio": "pnpm --filter @radar-quito/api db:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  }
}
