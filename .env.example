# ============================================
# RADAR QUITO — Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --------------------------------------------
# Database (PostgreSQL + PostGIS)
# --------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/radarquito

# --------------------------------------------
# JWT Authentication
# --------------------------------------------
JWT_SECRET=change-this-to-a-random-string-min-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-to-another-random-string-min-32-chars
JWT_REFRESH_EXPIRATION=7d

# --------------------------------------------
# CORS
# --------------------------------------------
CORS_ORIGIN=http://localhost:5173
CORS_ADMIN_ORIGIN=http://localhost:5174

# --------------------------------------------
# S3 / Cloudflare R2 (Image Storage)
# --------------------------------------------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=radar-quito-images
S3_REGION=auto
S3_PUBLIC_URL=https://pub-<hash>.r2.dev

# --------------------------------------------
# Mapbox (Frontend - web and admin)
# --------------------------------------------
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# --------------------------------------------
# API
# --------------------------------------------
NODE_ENV=development
API_PORT=3000
